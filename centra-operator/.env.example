# ==============================================================================
# CentraOperator Configuration
# Note: Defaults run 100% out-of-the-box in zero-dependency offline mode!
# ==============================================================================

# Target ERP Configuration
ERP_PORT=4000
ERP_BASE_URL=http://localhost:4000
ERP_READ_ONLY_TOKEN=ro_audit_token_9941

# Agent Runtime (FastAPI + LangGraph)
RUNTIME_PORT=8000
RUNTIME_URL=http://localhost:8000

# API Gateway & WebSocket Relay
GATEWAY_PORT=3000

# (Optional) External Production Services
# If omitted or offline, the system seamlessly uses embedded in-memory stores.
OPENAI_API_KEY=
REDIS_URL=redis://localhost:6379
MONGODB_URI=mongodb://localhost:27017
QDRANT_URL=http://localhost:6333
